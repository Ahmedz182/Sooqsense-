# Public site URL (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://sooqsense.com
# Where every "Start free trial" / "Sign in" button points
NEXT_PUBLIC_APP_URL=https://staging.sooqsense.com
# Optional: booking link for "Book a demo"
NEXT_PUBLIC_DEMO_URL=

# Waitlist / contact delivery (all optional — without them leads are only logged on the server)
# Option 1: email via Resend
RESEND_API_KEY=
LEADS_TO_EMAIL=
LEADS_FROM_EMAIL=
# Option 2: POST every lead as JSON to a webhook (Zapier, Make, HubSpot, n8n, ...)
LEADS_WEBHOOK_URL=
NEXT_PUBLIC_FONT=geist  # geist | general | instrument | satoshi
